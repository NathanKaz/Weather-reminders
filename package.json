{
  "name": "weather-reminders",
  "version": "1.0.0",
  "description": "Desktop reminders based on weather forecast (Open-Meteo)",
  "author": "NathanK <229133308+NathanKaz@users.noreply.github.com>",
  "desktopName": "weather-reminders.desktop",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "start": "npm run build:electron && concurrently -k \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:electron && vite build",
    "typecheck": "tsc --noEmit && npm run build:electron -- --noEmit",
    "test": "npm run build:electron && node --test dist-electron/*.test.js",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.weatherreminders.app",
    "productName": "Weather Reminders",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!dist-electron/**/*.test.js",
      "!dist-electron/**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "executableName": "weather-reminders",
      "syncDesktopName": true,
      "maintainer": "NathanK <229133308+NathanKaz@users.noreply.github.com>"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "appImage": {
      "artifactName": "${productName}-${version}.${ext}"
    },
    "deb": {
      "artifactName": "${productName}-${version}.${ext}",
      "synopsis": "Temperature reminders based on weather forecast",
      "description": "Desktop reminders that notify you when a temperature threshold or range appears in the Open-Meteo forecast."
    }
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  }
}
